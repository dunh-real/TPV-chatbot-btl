[Unit]
Description=TPV Presenton MCP Server
After=network.target tpv-presenton-api.service
Wants=tpv-presenton-api.service

[Service]
Type=simple
User=abc
Group=abc
WorkingDirectory=/home/abc/opt/presenton/app/servers/fastapi

EnvironmentFile=/home/abc/opt/presenton/presenton.env

ExecStart=/home/abc/opt/presenton/.venv/bin/python mcp_server.py --port 18001

Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
