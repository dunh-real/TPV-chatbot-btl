[Unit]
Description=TPV Qdrant Vector Database
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=abc
Group=abc

WorkingDirectory=/home/abc/opt/qdrant/1.19.2

Environment=QDRANT__STORAGE__STORAGE_PATH=/home/abc/kien_workspace/TPV-chatbot-btl/backend/qdrant_storage
Environment=QDRANT__SERVICE__HOST=127.0.0.1
Environment=QDRANT__SERVICE__HTTP_PORT=6333

ExecStart=/home/abc/opt/qdrant/1.19.2/musl/qdrant

Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target