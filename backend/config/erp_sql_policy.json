    "dbo.Hrm_EmployeeProfile": {
      "permissions_any": [
        "Hrm.EmployeeProfile.View",
        "Hrm.EmployeeProfile.ViewMine"
      ],
      "columns": [
        "Id",
        "TenantId",
        "CreationTime",
        "IsDeleted",
        "DeletionTime",
        "WorkDepartmentId",
        "WorkPositionId",
        "HireDate",
        "ResignationDate",
        "EmployeeId",
        "EmployeeCode",
        "FullName"
      ],
      "meaning": "Hồ sơ nhân sự trong phạm vi nhóm tài khoản; được đọc mã và họ tên, không cấp giấy tờ, liên hệ, lương. Số cuối tháng suy từ HireDate/CreationTime và ResignationDate, không phải snapshot lịch sử đầy đủ. Mốc cuối tháng dùng đầu tháng sau, khoảng ngày nửa mở."
    },
