# ---------------------------------------------------------------- Ứng dụng ---
APP_NAME="TPV Chatbot Backend"
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------- LLM (vLLM) ---
# Khởi động:  ./scripts/serve_vllm.sh
# Qwen3.6-35B-A3B-FP8 trên 1 card; model có vision nên phục vụ luôn OCR.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.6-35b
# Model nhẹ hơn cho bước viết lại truy vấn (để trống = dùng LLM_MODEL)
LLM_UTILITY_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=5000
LLM_TIMEOUT=120

# -------------------------------------------------------------- Qdrant -----
# docker run -p 6333:6333 -p 6334:6334 -v $PWD/qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tpv_documents
# Hội thoại lưu riêng một collection - mất Redis không mất lịch sử chat
QDRANT_CONVERSATION_COLLECTION=tpv_conversations
QDRANT_TIMEOUT=30
DENSE_VECTOR_SIZE=1024

# ----------------------------------------------------------- Embedding -----
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
SPARSE_LINEAR_REPO=BAAI/bge-m3
SPARSE_LINEAR_FILE=sparse_linear.pt
# vLLM chiếm card 0; để embedding + reranker sang card 1 cho khỏi tranh VRAM.
# Chỉ có một card thì đặt "cuda" và hạ UTIL của vLLM xuống 0.85.
EMBEDDING_DEVICE=cuda:1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_FP16=true
# Nạp sẵn model lúc khởi động (request đầu không phải chờ ~5s)
WARMUP_MODELS=true

# ------------------------------------------------------------ Reranker -----
RERANKER_MODEL=AITeamVN/Vietnamese_Reranker
RERANKER_DEVICE=cuda:1
RERANKER_BATCH_SIZE=8
# Phải đủ lớn để chứa cả câu hỏi lẫn chunk 1200 token
RERANKER_MAX_LENGTH=2048

# ---------------------------------------------------------------- BM25 -----
BM25_K1=1.5
BM25_B=0.75
BM25_AVG_LEN=256
BM25_USE_BIGRAMS=true

# ----------------------------------------------------------------- OCR -----
# Qwen3.6-35B-A3B có sẵn vision encoder nên CHÍNH server LLM ở trên làm luôn OCR:
# không cần dựng server thứ hai, không tốn thêm card.
OCR_ENABLED=true
OCR_BASE_URL=http://localhost:8000/v1
OCR_API_KEY=EMPTY
OCR_MODEL=qwen3.6-35b
OCR_MAX_CONCURRENCY=8
OCR_RENDER_SCALE=4.1667
OCR_IMAGE_MAX_SIDE=1568
OCR_TIMEOUT=180
OCR_MAX_TOKENS=6000
# 0.0 = tái lập được: nạp lại cùng tài liệu ra cùng text (xem chú thích config.py)
OCR_TEMPERATURE=0.0
OCR_TOP_P=0.8
OCR_REPETITION_PENALTY=1.0
# Số lần gọi lại một trang khi VLM lỗi (trang hỏng = mất hẳn một đoạn tài liệu)
OCR_MAX_RETRIES=3
# Trang có ảnh phủ >= tỉ lệ này và không chữ nào nhìn thấy được = trang scan,
# kết luận ngay. Bắt đúng PDF scan đã bị đóng kèm lớp chữ Tesseract sai.
OCR_SCAN_IMAGE_COVERAGE=0.7
# Trang không rơi vào hình dạng trên mới xét tiếp: cần >= 2/3 tín hiệu đồng thuận
OCR_CHAR_THRESHOLD_ABS=100
OCR_CHAR_THRESHOLD_RATIO=0.3
OCR_MIN_FONTS=1

# ------------------------------------------------------------ Chunking -----
# Đo bằng token của tokenizer embedding
CHUNK_MIN_TOKENS=200      # nhỏ hơn mức này -> gộp vào chunk kề (không gộp xuyên chương)
CHUNK_IDEAL_TOKENS=700    # kích thước nhắm tới khi đóng gói
CHUNK_MAX_TOKENS=1200     # vượt mức này -> cắt tiếp
CHUNK_HARD_CAP=1500       # trần tuyệt đối
CHUNK_OVERLAP=100
# Thẻ thông tin văn bản: thêm một chunk riêng gom số ký hiệu, ngày ban hành,
# trích yếu, kính gửi, nơi nhận, người ký. Câu hỏi "ai ký văn bản này" sẽ chấm
# điểm trên thẻ ngắn đó thay vì trên cả văn bản dài. Đổi giá trị -> phải NẠP LẠI kho.
DOC_CARD_ENABLED=true

# ----------------------------------------------------------- Retrieval -----
RETRIEVAL_BRANCH_LIMIT=50     # top-k mỗi nhánh trước khi RRF
RRF_K=60
RRF_TOP_K=20                  # số ứng viên đưa vào reranker
RERANK_TOP_N=4                # số chunk vào ngữ cảnh (chunk dài hơn nên cần ít hơn)
RERANK_SCORE_THRESHOLD=0.1    # dưới ngưỡng => trả lời "không tìm thấy"
RERANK_MAX_QUERIES=5          # số cách diễn đạt đem đi chấm (gốc + viết lại + biến thể); 1 = như cũ
WEIGHT_DENSE=1.0
WEIGHT_LEXICAL=0.8
WEIGHT_BM25=0.7
# Van cứu từ khoá: chunk chứa NGUYÊN VĂN mọi từ khoá của câu hỏi thì không bị
# ngưỡng rerank vứt đi. Reranker chấm cả chunk, nên một công văn dài mà chỉ dòng
# cuối ghi "TỔNG GIÁM ĐỐC Nguyễn Văn Phúc" luôn dưới ngưỡng - tắt van này thì hỏi
# "Ai là Tổng giám đốc?" sẽ nhận "không có trong tài liệu".
LEXICAL_RESCUE_ENABLED=true
LEXICAL_RESCUE_TOP_K=2

# -------------------------------------------------------- Query rewrite ----
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_VARIANTS=3
QUERY_REWRITE_TIMEOUT=20
QUERY_REWRITE_HISTORY_TURNS=4

# --------------------------------------------------------------- Context ---
CONTEXT_MAX_CHARS=16000
CONTEXT_LANGUAGE=vi

# ----------------------------------------------------------------- Redis ---
# Dùng container riêng cho dự án này, đừng chung port với dự án khác trên cùng máy:
#   docker run --name tpv-chatbot-redis -p 127.0.0.1:6382:6379 -d redis:7-alpine
REDIS_URL=redis://localhost:6382/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
HISTORY_MAX_TURNS=20

# ------------------------------------------------- SQLite pháp lý ---
# Chỉ lưu điều khoản, phiên bản và bằng chứng câu trả lời.
DATABASE_URL=sqlite+aiosqlite:///./legal_data/legal.db
# Bắt buộc cho mẫu, văn bản và đăng ký đầu ra; không tự tạo bảng MSSQL.
AI_DATABASE_URL=
# Bỏ trống: chọn phân vùng cá nhân của tài khoản; admin có thể chọn ID cùng tenant.
# AI_DEFAULT_PARTITION_ID=123
DATABASE_ECHO=false

# ------------------------------------------------- CSDL ERP (CHỈ ĐỌC) ---
# Nguồn phòng ban / trang bị / nhân sự. Hệ thống chỉ ĐỌC: mọi câu lệnh ghi bị
# chặn ghi tại engine; SQL model bị giới hạn bảng/cột theo config/erp_sql_policy.json.
# Bỏ trống => tắt phần số liệu ERP, các tool báo "chưa cấu hình".
#   ERP_DATABASE_URL=mssql+aioodbc://user:MatKhau@host:1433/db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
ERP_DATABASE_URL=
ERP_ECHO=false
# Giữ quy tắc Admin tĩnh toàn quyền hiện tại; false = chỉ dùng grant DB tường minh.
ERP_STATIC_ADMIN_FULL_ACCESS=true

# Pipeline discovery nội bộ thay phần truy vấn số liệu ERP cố định.
ERP_TEXT2SQL_BASE_URL=http://127.0.0.1:15000/v1
ERP_TEXT2SQL_API_KEY=EMPTY
ERP_TEXT2SQL_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
ERP_TEXT2SQL_TIMEOUT=180
ERP_TEXT2SQL_QUERY_TIMEOUT=30
ERP_TEXT2SQL_MAX_TOKENS=8192
ERP_TEXT2SQL_MAX_REPAIRS=2
ERP_TEXT2SQL_MAX_TOOL_CALLS=12
ERP_TEXT2SQL_MAX_ROWS=5000
# vLLM phải hỗ trợ native tool calling (enable-auto-tool-choice + tool-call-parser).
# Pipeline này luôn thinking=false, độc lập với LLM_ENABLE_THINKING của chat.
# Cần tenant cụ thể và quyền tài khoản đã tra từ ERP; chỉ ERP_TENANT_ID là chưa đủ.

# ERP chạy đa tenant. Đây là tenant MẶC ĐỊNH, chỉ dùng khi request không khai
# danh tính (script, tác vụ nền, test). Discovery yêu cầu tenant và tài khoản có quyền.
ERP_TENANT_ID=64

# Danh tính của một request lấy theo thứ tự: token đăng nhập -> header -> mặc định
# trên. Khi chưa có đăng nhập, client tự khai qua header:
#     X-Tenant-Id: 64
#     X-User-Id:   nguyenvana
# Bật cờ này = tin lời khai đó, tức ai gọi được API cũng đọc được tenant bất kỳ.
# PHẢI đặt false khi giao diện đã có đăng nhập - lúc đó chỉ token nói được danh tính.
TRUST_IDENTITY_HEADERS=true

# --------------------------------------------------------------- Storage ---
MINIO_ENDPOINT=s3.tpvtech.vn
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_BUCKET=btl-ai
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/output

# ------------------------------------------------- Mở ra Internet (tuỳ chọn) ---
# Rỗng = không chặn ai (chạy trong mạng nội bộ). Đặt một chuỗi bất kỳ khi public
# qua Cloudflare tunnel: mọi request phải kèm ?token=... (lần đầu) hoặc header
# X-Access-Token. Xem scripts/serve_public.sh
PUBLIC_ACCESS_TOKEN=

# Cloudflare named tunnel - domain cố định. Token lấy ở Zero Trust → Networks →
# Tunnels → tunnel của bạn → Configure. Đây là CREDENTIAL: ai có nó cũng chạy
# được tunnel của bạn, nên nó chỉ nằm trong .env (đã gitignore), không lên repo.
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_HOSTNAME=

# ------------------------------------------------- Presenton (workflow 5) ---
# Bộ slide do Presenton dựng (Docker):
#   docker compose --env-file .env -f docker/presenton.yml up -d
# Cổng 5002 vì 5001 thường đã có Presenton của dự án khác trên cùng máy dev.
PRESENTON_URL=http://127.0.0.1:5002
PRESENTON_PORT=5002
PRESENTON_LLM=custom
# Mặc định: vLLM LOCAL, không gọi ra ngoài, không tốn tiền mỗi lần tạo slide.
#
# Chạy cả hệ bằng docker-compose.yml (profile gpu): vLLM nằm cùng mạng Docker,
# gọi thẳng http://vllm:8000/v1, không cần relay.
#
# vLLM chạy NGOÀI Docker trên máy chủ (kiểu cũ): đặt
# http://172.22.0.1:8001/v1 và bật relay - xem đầu scripts/vllm_relay.py.
#
# Muốn dùng model API bên ngoài thì đổi hai dòng dưới thành endpoint đó và điền
# khoá thật vào `llm_slide_api_key`.
PRESENTON_CUSTOM_LLM_URL=http://vllm:8000/v1
PRESENTON_CUSTOM_MODEL=qwen3.6-35b
# Khoá của model API sinh slide. vLLM local không kiểm khoá nên để EMPTY; bỏ
# trống hẳn thì `docker compose up` gãy vì compose khai biến này là bắt buộc.
llm_slide_api_key=EMPTY
# Để trống khi chạy với DISABLE_AUTH=true (mặc định của docker/presenton.yml).
# Bật đăng nhập thì điền vào đây, client tự đăng nhập trước khi gọi - nhưng đọc
# ghi chú trong docker/presenton.yml trước: bật lên thì bước export nhận 401.
PRESENTON_USERNAME=
PRESENTON_PASSWORD=
# Chỉ nhận: general | modern | standard | swift (tên khác bị Presenton trả 400).
# modern = xanh dương trên nền trắng; general là tông tím.
PRESENTON_TEMPLATE=modern
# Ép font cho file .pptx sau khi xuất; để trống là giữ font của template
PRESENTON_FONT=Times New Roman
# 0 = code tự tính số slide theo lượng số liệu.
PRESENTON_N_SLIDES=0
PRESENTON_MAX_WAIT_SECONDS=900

# Schema đầy đủ trên đĩa; model chỉ nhận phần đã lọc quyền.
ERP_SCHEMA_FILE=data/erp_schema.json
ERP_SCHEMA_REFRESH_SECONDS=300
ERP_SQL_POLICY_FILE=config/erp_sql_policy.json
# Mô tả nghiệp vụ do đội ERP cập nhật; đọc lại ở mỗi truy vấn.
ERP_SEMANTIC_FILE=config/erp_semantic.yaml

# Bucket có sẵn được phép nạp; MINIO_BUCKET luôn được phép.
MINIO_INGEST_BUCKETS=["vanbantrunguong","vanbandiaphuong"]

# UC37: worker lấy tác vụ trên MSSQL; không cần Redis hay bảng mới.
TASK_WORKER_ENABLED=true
TASK_WORKER_POLL_SECONDS=2
TASK_LEASE_SECONDS=120
TASK_EXECUTION_TIMEOUT_SECONDS=1800

# Tạo slide từ DOCX/PDF có lớp chữ; số slide tính cả bìa.
SLIDE_MAX_SLIDES=15
SLIDE_DOCUMENT_MAX_MB=20
SLIDE_DOCUMENT_MAX_CHARS=60000

# Nguồn MinIO BE (S3 API endpoint, không phải trang Console); chỉ đọc bucket được cấp.
BE_MINIO_ENDPOINT=
BE_MINIO_ACCESS_KEY=
BE_MINIO_SECRET_KEY=
BE_MINIO_SECURE=true
BE_MINIO_BUCKETS=[]
