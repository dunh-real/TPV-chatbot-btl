# ---------------------------------------------------------------- Ứng dụng ---
APP_NAME="TPV Chatbot Backend"
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------- LLM (vLLM) ---
# Khởi động:  ./scripts/serve_vllm.sh
# Qwen3.6-35B-A3B-FP8 trên 1 card; model có vision nên phục vụ luôn OCR.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.6-35b
# Model nhẹ hơn cho bước viết lại truy vấn (để trống = dùng LLM_MODEL)
LLM_UTILITY_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=5000
LLM_TIMEOUT=120

# -------------------------------------------------------------- Qdrant -----
# docker run -p 6333:6333 -p 6334:6334 -v $PWD/qdrant_storage:/qdrant/storage qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tpv_documents
# Hội thoại lưu riêng một collection - mất Redis không mất lịch sử chat
QDRANT_CONVERSATION_COLLECTION=tpv_conversations
QDRANT_TIMEOUT=30
DENSE_VECTOR_SIZE=1024

# ----------------------------------------------------------- Embedding -----
EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
SPARSE_LINEAR_REPO=BAAI/bge-m3
SPARSE_LINEAR_FILE=sparse_linear.pt
# vLLM chiếm card 0; để embedding + reranker sang card 1 cho khỏi tranh VRAM.
# Chỉ có một card thì đặt "cuda" và hạ UTIL của vLLM xuống 0.85.
EMBEDDING_DEVICE=cuda:1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_LENGTH=1024
EMBEDDING_FP16=true
# Nạp sẵn model lúc khởi động (request đầu không phải chờ ~5s)
WARMUP_MODELS=true

# ------------------------------------------------------------ Reranker -----
RERANKER_MODEL=AITeamVN/Vietnamese_Reranker
RERANKER_DEVICE=cuda:1
RERANKER_BATCH_SIZE=8
# Phải đủ lớn để chứa cả câu hỏi lẫn chunk 1200 token
RERANKER_MAX_LENGTH=2048

# ---------------------------------------------------------------- BM25 -----
BM25_K1=1.5
BM25_B=0.75
BM25_AVG_LEN=256
BM25_USE_BIGRAMS=true

# ----------------------------------------------------------------- OCR -----
# Qwen3.6-35B-A3B có sẵn vision encoder nên CHÍNH server LLM ở trên làm luôn OCR:
# không cần dựng server thứ hai, không tốn thêm card.
OCR_ENABLED=true
OCR_BASE_URL=http://localhost:8000/v1
OCR_API_KEY=EMPTY
OCR_MODEL=qwen3.6-35b
OCR_MAX_CONCURRENCY=8
OCR_RENDER_SCALE=3.0
OCR_TIMEOUT=180
OCR_MAX_TOKENS=4096
# Phân loại trang scan: cần >= 2/3 tín hiệu đồng thuận
OCR_CHAR_THRESHOLD_ABS=100
OCR_CHAR_THRESHOLD_RATIO=0.3
OCR_MIN_FONTS=1

# ------------------------------------------------------------ Chunking -----
# Đo bằng token của tokenizer embedding
CHUNK_MIN_TOKENS=200      # nhỏ hơn mức này -> gộp vào chunk kề (không gộp xuyên chương)
CHUNK_IDEAL_TOKENS=700    # kích thước nhắm tới khi đóng gói
CHUNK_MAX_TOKENS=1200     # vượt mức này -> cắt tiếp
CHUNK_HARD_CAP=1500       # trần tuyệt đối
CHUNK_OVERLAP=100

# ----------------------------------------------------------- Retrieval -----
RETRIEVAL_BRANCH_LIMIT=50     # top-k mỗi nhánh trước khi RRF
RRF_K=60
RRF_TOP_K=20                  # số ứng viên đưa vào reranker
RERANK_TOP_N=4                # số chunk vào ngữ cảnh (chunk dài hơn nên cần ít hơn)
RERANK_SCORE_THRESHOLD=0.1    # dưới ngưỡng => trả lời "không tìm thấy"
WEIGHT_DENSE=1.0
WEIGHT_LEXICAL=0.8
WEIGHT_BM25=0.7

# -------------------------------------------------------- Query rewrite ----
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_VARIANTS=3
QUERY_REWRITE_TIMEOUT=20
QUERY_REWRITE_HISTORY_TURNS=4

# --------------------------------------------------------------- Context ---
CONTEXT_MAX_CHARS=16000
CONTEXT_LANGUAGE=vi

# ----------------------------------------------------------------- Redis ---
# Redis 6379 trên máy này đang được dự án khác dùng -> tách sang DB index riêng
REDIS_URL=redis://localhost:6379/3
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
HISTORY_MAX_TURNS=20

# ------------------------------------------- CSDL nghiệp vụ (SQL Server) ---
# SQL Server (driver ODBC 18 đã có sẵn trên máy):
#   DATABASE_URL=mssql+aioodbc://sa:MatKhau@localhost:1433/tpv?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Demo/dev không cần server:
DATABASE_URL=sqlite+aiosqlite:///./data/demo.db
DATABASE_ECHO=false

# --------------------------------------------------------------- Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=tpv-documents
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/output
